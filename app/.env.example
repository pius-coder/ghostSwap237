# Browser variables embedded by Vite (required for production builds)
VITE_API_BASE_URL=https://your-project.vercel.app/api
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_supabase_anon_key

# Optional browser links; these are public values, not server credentials
VITE_REACTOR_API_URL=https://api.reactor.inc
VITE_REACTOR_DASHBOARD_URL=https://dashboard.reactor.inc

# Supabase server only
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# WhatsApp support gateway (server only)
# WHATSAPP_BAILEYS_URL must point to the persistent Baileys service /notifications endpoint.
WHATSAPP_BAILEYS_URL=http://127.0.0.1:3010/notifications
WHATSAPP_BAILEYS_SECRET=replace_with_at_least_32_random_characters
BAILEYS_PORT=3010
# Mount this directory on a private persistent volume in production. Never commit its contents.
BAILEYS_AUTH_DIR=.baileys-auth
# Shared only by the Henshin server and Baileys service; used for durable outbox retries.
NOTIFICATION_DISPATCH_TOKEN=replace_with_another_32_character_random_secret
HENSHIN_NOTIFICATION_DISPATCH_URL=https://your-project.vercel.app/api/dispatch-notifications

# Fapshi server only
FAPSHI_BASE_URL=https://live.fapshi.com
FAPSHI_APIUSER=your_server_only_api_user
FAPSHI_APIKEY=your_server_only_api_key
FAPSHI_WEBHOOK_SECRET=your_server_only_webhook_secret
APP_PUBLIC_URL=https://your-project.vercel.app
PAYMENT_RETURN_URL=https://your-project.vercel.app
FAPSHI_APP_RETURN_URL=https://henshin.numzer0.store/api/payment/fapshi-return
# Configure this exact URL in the Fapshi dashboard (informational only).
FAPSHI_WEBHOOK_URL=https://henshin.numzer0.store/api/payment/fapshi-webhook

# Chariow server only (international checkout + Pulse signature)
CHARIOW_API_KEY=your_server_only_chariow_api_key
CHARIOW_WEBHOOK_SECRET=your_server_only_chariow_pulse_secret

# Reactor and Morphly server only
REACTOR_API_KEY=your_server_only_reactor_key
REACTOR_API_URL=https://api.reactor.inc
MORPHLY_API_KEY=your_server_only_morphly_key

# Optional exchange-rate provider key, server only
EXCHANGE_RATE_API_KEY=your_server_only_exchange_rate_key

# GitHub Releases updater
DESKTOP_GITHUB_OWNER=pius-coder
DESKTOP_GITHUB_REPO=ghostSwap237
DESKTOP_GITHUB_EXE_PATTERN=^Henshin-Setup-\d+\.\d+\.\d+\.exe$
# Optional server-only token for private repositories or a higher API rate limit
GITHUB_TOKEN=

# Direct/Supabase updater fallback, currently aligned with package version
DESKTOP_LATEST_VERSION=2.0.25
DESKTOP_ARTIFACT_TYPE=installer
DESKTOP_RELEASE_NOTES=Henshin 2.0.25
DESKTOP_DOWNLOAD_SHA256=
DESKTOP_DOWNLOAD_URL=
DESKTOP_SUPABASE_BUCKET=henshin-updates
DESKTOP_SUPABASE_PATH=desktop/Henshin-Setup-{version}.exe
DESKTOP_SUPABASE_ACCESS=signed
DESKTOP_SIGNED_URL_EXPIRES=7200
