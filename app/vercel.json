{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "bunVersion": "1.x",
  "framework": "vite",
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "bun run vercel:build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/morphly-token",
      "destination": "/api/start-session?action=morphly-token"
    },
    {
      "source": "/api/payment/fapshi-init",
      "destination": "/api/wallet?action=fapshi-init"
    },
    {
      "source": "/api/payment/fapshi-return",
      "destination": "/api/wallet?action=fapshi-return"
    },
    {
      "source": "/api/payment/fapshi-status",
      "destination": "/api/wallet?action=fapshi-status"
    },
    {
      "source": "/api/payment/fapshi-webhook",
      "destination": "/api/wallet?action=fapshi-webhook"
    }
  ]
}
